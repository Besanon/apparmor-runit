abi <abi/4.0>,

include <tunables/global>

@{exec_path} = /sbin/chpst @{bin}/chpst
profile chpst  /{,usr/}{,s}bin/chpst {
  include <abstractions/base-strict>
  include <abstractions/nameservice-strict>
  include <abstractions/devices-usb>

  network inet stream,
  network inet dgram,
  network inet raw,
  network netlink raw,
  network packet dgram,

  capability setgid,
  capability setuid,
  capability fsetid,

  signal (receive)  peer=runsv,

  @{exec_path} 	mr,

  @{bin}/agetty		rPx,
  @{bin}/pause 		rPx,
  @{bin}/stubby		rix,
  @{bin}/socklog 	rix,

  include if exists <local/chpst>
}

# vim:syntax=apparmor
